{
  "name": "react-recaptcha-that-works",
  "description": "⚛ A reCAPTCHA bridge for React that works.",
  "version": "2.0.2",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douglasjunior/react-recaptcha-that-works.git"
  },
  "keywords": [
    "react",
    "captcha",
    "recaptcha",
    "kiss"
  ],
  "author": {
    "name": "Douglas Nassif Roma Junior",
    "email": "nassifrroma@gmail.com",
    "url": "https://github.com/douglasjunior"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/douglasjunior/react-recaptcha-that-works/issues"
  },
  "homepage": "https://github.com/douglasjunior/react-recaptcha-that-works",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean.js && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-module-types.js",
    "check-package": "node scripts/check-package.js",
    "test": "yarn build && yarn check-package",
    "prepack": "yarn build"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
